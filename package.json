{
  "name": "nowro-korea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:backup": "node scripts/database-backup.mjs",
    "deploy:check": "node scripts/check-deployment.mjs",
    "android:prepare": "node scripts/prepare-android.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/leaflet": "1.9.22",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  }
}
