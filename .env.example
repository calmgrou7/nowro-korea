# Server-side only. No secrets belong in VITE_ variables.
PORT=8787
HOST=127.0.0.1
DATA_DIR=.data
# Optional, both required to enable structured natural-language extraction.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_DAILY_CALL_LIMIT=50
# Partner/admin preview is disabled unless explicitly enabled on localhost.
ENABLE_LOCAL_OPERATOR_PREVIEW=false
# Supabase integration is a release prerequisite; see docs/OPERATIONS.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Current HTTPS app origin for the default Supabase email link flow. Match Supabase Site URL.
PUBLIC_APP_URL=
# Android TWA association. SHA-256 certificate fingerprints are public values, comma-separated.
# Use Google Play's APP SIGNING certificate for store installs, not just the upload certificate.
ANDROID_APP_ID=
ANDROID_SHA256_FINGERPRINTS=
# Optional public tile URL; no secret key. Default OSM tiles are for light development use.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Future store links (HTTPS only). Empty values show Coming soon.
DISCOUNT_SHOP_URL=
GOODS_SHOP_URL=
TICKET_REGISTER_URL=
# Public-data API keys. Keep these server-side only; never use VITE_ prefixes.
BUSAN_FOODIE_API_KEY=
BUSAN_EXHIBIT_API_KEY=
BUSAN_MARITIME_API_KEY=
BUSAN_THEATRE_API_KEY=
BUSAN_FESTIVAL_API_KEY=
KTO_KOREAN_API_KEY=
KTO_ENGLISH_API_KEY=
# Public demo hosting only; must keep operator preview disabled.
DEPLOYMENT_MODE=local
